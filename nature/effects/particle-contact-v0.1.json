{
  "id": "particle-water-contact",
  "version": "0.1.0",
  "status": "prototype",
  "sourceDemo": "nature/demos/blue-pond-seasons-005.html",
  "geometryOcclusion": {
    "method": "ray vs standing tree trunk/branches, two-layer woodland silhouette, water wave surface and shoreline",
    "pixelRayTest": true,
    "forestAlphaThreshold": 0.55
