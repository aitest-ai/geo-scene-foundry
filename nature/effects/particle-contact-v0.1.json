  "rippleContacts": {
    "maxEvents": 12,
    "lifeSeconds": 2.25,
    "normalPerturbation": true,
    "physicallyMeasured": false
  },
  "unsupported": [
    "snow accumulation",
    "fallen leaves persistence",
    "physical fluid dynamics",
    "game collision",
    "Open Water FFT"
  ],
  "qa": {
    "webgl2Verified": false,
    "mobileVerified": false,
    "sourceMapsUnchanged": true
  }
}
